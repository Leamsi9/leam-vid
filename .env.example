# Copy OUTSIDE the repository (for example ~/.config/leam-vid/environment).
# Set this only after publishing your built image and checking its registry digest.
export LEAM_VID_IMAGE='docker.io/YOUR_USER/leam-vid@sha256:YOUR_PUBLISHED_DIGEST'
export LEAM_VID_MODELS='turbowan,h3'
export LEAM_VID_DISK_GB=120
# Defaults below are optional. Credential files must stay outside Git.
export LEAM_VID_DATA_DIR="$HOME/.local/share/leam-vid"
export LEAM_VID_SSH_IDENTITY="$HOME/.ssh/leam-vid"
export LEAM_VID_VAST_KEY_FILE="$HOME/.config/vastai/vast_api_key"
export LEAM_VID_BIND='127.0.0.1'
export LEAM_VID_PORT=8189
export LEAM_VID_ORIGINS='http://127.0.0.1:8189,http://localhost:8189'
# To add a private reverse proxy, also allow its EXACT https origin here;
# to bind to a private network address, add that address to BIND.
